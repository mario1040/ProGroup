{
  "entities": {
    "profile": {
      "title": "User Profile",
      "description": "Employee and admin profiles",
      "type": "object"
    },
    "location": {
      "title": "Location",
      "description": "Company locations/offices",
      "type": "object"
    },
    "zone": {
      "title": "Zone",
      "description": "Specific areas within a location",
      "type": "object"
    },
    "task_template": {
      "title": "Task Template",
      "description": "Standard Operating Procedure (SOP) task templates",
      "type": "object"
    },
    "task_instance": {
      "title": "Task Instance",
      "description": "Generated task instances for daily execution",
      "type": "object"
    },
    "operational_task": {
      "title": "Operational Task",
      "description": "Tasks relating to electrical switches, ACs, lights",
      "type": "object"
    },
    "kpi_snapshot": {
      "title": "KPI Snapshot",
      "description": "Weekly performance scorecards for employees",
      "type": "object"
    },
    "notification": {
      "title": "Notification",
      "description": "In-app alerts for employees",
      "type": "object"
    },
    "device_switch": {
      "title": "Device Switch",
      "description": "Control panel switches mapped to zones",
      "type": "object"
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "profile",
      "description": "Direct collection containing individual user/employee records."
    },
    "/locations/{locationId}": {
      "schema": "location",
      "description": "Direct collection containing locations."
    },
    "/zones/{zoneId}": {
      "schema": "zone",
      "description": "Direct collection containing zones."
    },
    "/task_templates/{templateId}": {
      "schema": "task_template",
      "description": "Direct collection containing task templates."
    },
    "/task_instances/{instanceId}": {
      "schema": "task_instance",
      "description": "Direct collection containing task instances."
    },
    "/operational_tasks/{taskId}": {
      "schema": "operational_task",
      "description": "Direct collection containing operational tasks."
    },
    "/kpi_snapshots/{kpiId}": {
      "schema": "kpi_snapshot",
      "description": "Direct collection containing KPI snapshots."
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Direct collection containing notifications."
    },
    "/device_switches/{switchId}": {
      "schema": "device_switch",
      "description": "Direct collection containing device switches."
    }
  }
}
