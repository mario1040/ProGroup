rules_version = '2';

// Naris Ops production Storage lockdown.
//
// The current browser application uses a custom Firestore username/password
// flow and does not establish request.auth. Storage Rules cannot trust that
// client-side session, so every direct browser operation is denied until a
// trusted backend or Firebase Auth/custom-claims bridge is deployed.
//
// Do not use `if true`, localStorage, custom headers, or App Check alone for
// employee-level authorization. They do not provide a trusted user identity.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Historical Storage objects are not deleted by these rules; only access is
// changed. Backend/Admin SDK operations bypass these rules and must enforce
// authentication, role checks, active-account checks, content-type/size limits,
// path ownership, malware scanning where appropriate, and audit logging.
//
// Intended future object layout:
// task-photos/{zoneId}/{taskInstanceId}/{before|after}.jpg
// zones/{zoneId}/cover.jpg
// sop_items/{sopItemId}/ref.jpg
//
// Reopen these paths only after a trusted identity is available to Rules and
// each write path has been validated against the corresponding Firestore task.

// References:
// https://firebase.google.com/docs/storage/security/rules-conditions
// https://firebase.google.com/docs/storage/security/rules-structure
