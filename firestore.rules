rules_version = '2';

// Naris Ops production lockdown.
//
// The current web application authenticates users through a custom Firestore
// username/password flow and does not establish request.auth. Firestore Rules
// cannot safely trust that client-side profile or password check. Therefore,
// every direct browser request is denied until a trusted backend or Firebase
// Auth/custom-claims bridge is deployed.
//
// Do not replace these denials with `if true`, profile fields, localStorage,
// custom headers, or App Check alone. None of those establish a trusted user
// identity for Firestore Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Required migration before reopening access:
// 1. Establish a trusted identity with Firebase Auth/custom claims, or route
//    all reads and writes through a server-side Admin SDK boundary.
// 2. Reintroduce collection-specific least-privilege rules only after that
//    identity is available to the rules engine.
// 3. Test with the Firebase Emulator and deploy rules before enabling clients.
//
// Historical documents are not changed by this file; it only changes access.
// Backend/Admin SDK requests bypass Firestore Rules and must be protected by
// server authentication, authorization, validation, rate limits, and audit logs.

/*
Example trusted-identity helper for a future Firebase Auth/custom-claims bridge:

function signedIn() {
  return request.auth != null;
}

function activeUser() {
  return signedIn() && request.auth.token.active == true;
}

function roleIs(role) {
  return activeUser() && request.auth.token.role == role;
}

Do not enable these helpers until the application actually signs in through the
same trusted identity represented by request.auth.token.
*/

// References:
// https://firebase.google.com/docs/firestore/security/rules-conditions
// https://firebase.google.com/docs/rules/rules-and-auth
// https://firebase.google.com/docs/firestore/security/rules-structure
